{
  "private": true,
  "name": "@projectname/server",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "wrangler dev",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check": "tsc --noEmit && eslint . && prettier . --check",
    "check:fix": " tsc --noEmit && eslint . --fix && prettier . --write",
    "test": "vitest run",
    "clean": "del .wrangler/tmp/ dist/ node_modules/.cache/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB",
    "deploy": "wrangler deploy --minify"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@projectname/shared": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.30",
    "hono-party": "^2.1.0",
    "partyserver": "^0.5.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@projectname/shared-config": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.10",
    "del-cli": "^7.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
